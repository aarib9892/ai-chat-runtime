# Copy this file to .env for Docker Compose. Do not commit the resulting .env file.
POSTGRES_DB=ai_chat_runtime
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Set this to an actual server-side OpenAI API key locally; leave it out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
